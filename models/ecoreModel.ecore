<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="AmEm" nsURI="http://AmEm/1.0" nsPrefix="AmEm">
  <eClassifiers xsi:type="ecore:EClass" name="Shuttle">
    <eStructuralFeatures xsi:type="ecore:EReference" name="at" eType="#//Track"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mode" eType="#//Mode"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sx1" eType="#//RsX1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sx2" eType="#//RsX2"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sx3" eType="#//RsX3"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sx4" eType="#//RsX4"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sx5" eType="#//RsX5"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sy1" eType="#//RsY1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sy2" eType="#//RsY2"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sy3" eType="#//RsY3"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sy4" eType="#//RsY4"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sy5" eType="#//RsY5"/>
