    <eStructuralFeatures xsi:type="ecore:EReference" name="m2" eType="#//Meta2"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="m3" eType="#//Meta3"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="m4" eType="#//Meta4"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="m5" eType="#//Meta5"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Track">
    <eStructuralFeatures xsi:type="ecore:EReference" name="next" eType="#//Track"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="stX1" eType="#//RsX1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="stX2" eType="#//RsX2"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="stX3" eType="#//RsX3"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="stX4" eType="#//RsX4"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="stX5" eType="#//RsX5"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="stY1" eType="#//RsY1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="stY2" eType="#//RsY2"/>
