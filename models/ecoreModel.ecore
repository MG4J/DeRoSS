    <eStructuralFeatures xsi:type="ecore:EReference" name="ry5" upperBound="-1" eType="#//RsY5"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="f1" upperBound="-1" eType="#//Meta1"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="f2" upperBound="-1" eType="#//Meta2"
