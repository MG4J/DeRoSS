    <eStructuralFeatures xsi:type="ecore:EReference" name="ry3" upperBound="-1" eType="#//RsY3"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ry4" upperBound="-1" eType="#//RsY4"
