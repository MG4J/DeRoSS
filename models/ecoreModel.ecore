    <eStructuralFeatures xsi:type="ecore:EReference" name="stY4" eType="#//RsY4"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="stY5" eType="#//RsY5"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Connection">
    <eStructuralFeatures xsi:type="ecore:EReference" name="source" eType="#//Shuttle"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" eType="#//Shuttle"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Conflict">
    <eStructuralFeatures xsi:type="ecore:EReference" name="at" upperBound="-1" eType="#//Track"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Model">
    <eStructuralFeatures xsi:type="ecore:EReference" name="shuttles" upperBound="-1"
        eType="#//Shuttle" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="tracks" upperBound="-1"
        eType="#//Track" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="conflicts" upperBound="-1"
        eType="#//Conflict" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rx1" upperBound="-1" eType="#//RsX1"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rx2" upperBound="-1" eType="#//RsX2"
