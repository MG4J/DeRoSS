<?xml version="1.0" encoding="UTF-8"?>
<henshin:Module xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:henshin="http://www.eclipse.org/emf/2011/Henshin"
    xmi:id="module1"
    name="ExampleModule">

  <imports href="platform:/plugin/org.eclipse.emf.ecore/model/Ecore.ecore#//"/>
  <imports href="http://example/phmm#//"/>

  <units xsi:type="henshin:Rule" xmi:id="rule1" name="ExampleRule">
    <lhs xmi:id="lhs1" name="LHS">
      <nodes xmi:id="lhs_n1" name="n1">
        <type href="http://www.eclipse.org/emf/2002/Ecore#//EClass"/>
      </nodes>
    </lhs>

    <rhs xmi:id="rhs1" name="RHS">
      <nodes xmi:id="rhs_n1" name="n1">
        <type href="http://www.eclipse.org/emf/2002/Ecore#//EClass"/>
      </nodes>
    </rhs>

    <mappings xmi:id="map1" origin="lhs_n1" image="rhs_n1"/>
  </units>
</henshin:Module>
